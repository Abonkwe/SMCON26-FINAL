# ALICE Backend Environment Configuration

# Project & Runtime
PROJECT_NAME="ALICE Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
PUBLIC_BASE_URL="http://localhost:8000"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Supabase Infrastructure (PostgreSQL, Auth, Storage)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_STORAGE_PUBLIC_BUCKET="public-media"
SUPABASE_STORAGE_PRIVATE_BUCKET="private-verification"

# Meta WhatsApp Cloud API (Graph API v22.0)
WHATSAPP_ACCESS_TOKEN="EAAB..."
WHATSAPP_PHONE_NUMBER_ID="100000000000000"
WHATSAPP_APP_SECRET="your_meta_app_secret_here"
WHATSAPP_VERIFY_TOKEN="your_meta_webhook_verify_token_here"
WHATSAPP_GRAPH_VERSION="v22.0"

# Google Gemini AI Integration
GEMINI_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
GEMINI_MODEL="gemini-2.5-flash"

# Twilio WhatsApp Business API Integration (Optional / Legacy)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

